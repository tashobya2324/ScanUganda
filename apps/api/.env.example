# Copy to .env and fill in. Never commit .env.
API_PORT=3000
# --- Database (PostgreSQL) ---
# A real Postgres server (Neon, Supabase, a container...). Leave empty for local development:
# the API then runs Postgres in-process (PGlite) with its data in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# --- Private signing keys ---
# Either one file per key in KEYS_DIR (Node hosts with a disk)...
KEYS_DIR=./data/keys
# ...or, when this is set, kept in the database ENCRYPTED with it (required on Cloudflare Workers).
# 32+ random characters, different from the secrets below. Losing it means no new codes for existing keys.
KEY_ENCRYPTION_KEY=
# Long random strings, different from each other. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
LOOKUP_PEPPER=
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
# Password for seeded demo users (dev only)
SEED_PASSWORD=

# --- USSD and SMS (optional; see docs/USSD-GO-LIVE.md) ---
# Shared secret the aggregator sends with callbacks (header x-channel-key or ?key=). 16+ characters. SET THIS IN ANY DEPLOYMENT.
CHANNEL_SECRET=
# Africa's Talking, only needed to send SMS replies. AT_SANDBOX=false selects the live service.
AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=true
AT_SMS_FROM=

# --- Production hardening (see docs/SECURITY.md) ---
# Set to true ONLY when the API sits behind a reverse proxy you control (it then reads X-Forwarded-For).
TRUST_PROXY=false
# Requests per minute per address. Defaults shown; raise VERIFY_RATE_LIMIT only for load tests.
# RATE_LIMIT_MAX=120
# VERIFY_RATE_LIMIT=60
# LOGIN_RATE_LIMIT=10
