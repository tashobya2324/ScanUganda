{
  "name": "@scanuganda/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed-cli.ts",
    "db:migrate": "tsx src/migrate-cli.ts",
    "dev:worker": "wrangler dev",
    "dev:worker:db": "tsx src/pg-serve-cli.ts",
    "deploy:worker": "wrangler deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.7",
    "@scanuganda/core": "workspace:*",
    "hono": "^4.13.18",
    "postgres": "^4.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  }
}
