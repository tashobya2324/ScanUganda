# Cloudflare static-asset headers (ignored by other hosts).
# The service worker and the list of files it caches must always be fresh, or phones keep an old app.
/sw.js
  Cache-Control: no-cache
/precache-manifest.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# File names under /assets/ contain a content hash: safe to keep for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
